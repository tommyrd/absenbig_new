# ==============================================================================
# Absensi BIGNET — PT Borneo Inovasi Gemilang
# Production & Development Environment Configuration Template
# Salin file ini ke `.env` pada server hosting, lalu isi nilai produksi.
# JANGAN PERNAH mengunggah file `.env` asli ke GitHub!
# ==============================================================================

# Environment mode: development | production
NODE_ENV=production

# HTTP server bind configuration
PORT=3000
HOST=0.0.0.0

# Timezone resmi perusahaan (WAJIB Asia/Jakarta untuk akurasi waktu server WIB)
TZ=Asia/Jakarta

# Public application URL (domain HTTPS perusahaan pada production)
APP_URL="https://absensi.bignet.co.id"

# Daftar origin yang diizinkan untuk CORS (pisahkan dengan koma, kosongkan untuk same-origin)
ALLOWED_ORIGINS="https://absensi.bignet.co.id"

# Secret penandatanganan token sesi (HMAC-SHA256).
# WAJIB diisi string acak minimal 32 karakter pada production.
# Generate cepat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# Direktori penyimpanan data persisten (database SQLite, foto selfie, avatar, aset logo).
# Pada VPS/hosting pribadi, arahkan ke volume/folder permanen di luar folder release kode.
DATA_DIR="./data"
DB_PATH="./data/bignet_absensi.db"

# Direktori penyimpanan arsip backup & retensi backup otomatis (hari)
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# Seeding control:
# - Pada production, biarkan SEED_DEMO_DATA=false dan ALLOW_DEMO_LOGIN=false!
# - Demo data hanya untuk lingkungan development/staging.
SEED_DEMO_DATA=false
ALLOW_DEMO_LOGIN=false

# Bootstrap akun Superadmin awal saat instalasi database production baru (opsional jika via CLI `npm run db:seed:prod`)
# Kosongkan setelah instalasi awal selesai.
BOOTSTRAP_SUPERADMIN_USERNAME="superadmin"
BOOTSTRAP_SUPERADMIN_EMAIL="owner@bignet.co.id"
BOOTSTRAP_SUPERADMIN_NAME="Superadmin BIGNET"
BOOTSTRAP_SUPERADMIN_PASSWORD=""

# Opsional: Geoapify Reverse Geocoding API untuk mengubah koordinat GPS menjadi alamat.
# Buat API key dari Geoapify MyProjects. Simpan hanya di server (.env), jangan gunakan awalan VITE_.
# Reverse Geocoding API: https://api.geoapify.com/v1/geocode/reverse
GEOAPIFY_API_KEY=""

# Opsional: Base URL API jika frontend di-serve dari origin terpisah (kosongkan jika same-origin / Nginx proxy)
VITE_API_BASE_URL=""

